# 环境变量配置示例
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写真实的凭据
# 3. 不要将 .env 提交到 Git

# ============================================
# 授权令牌（推荐使用，v0.3.0）
# ============================================

# scenario-test 会自动读取此环境变量用于 Authorization 头
SCENARIO_AUTH="Bearer your-token-here"

# ============================================
# API 凭据
# ============================================

# 示例项目的 API Key（替换为真实值）
DEMO_API_KEY="your-api-key-here"

# 示例项目的 API Secret（替换为真实值）
DEMO_API_SECRET="your-api-secret-here"

# ============================================
# 开发/生产环境
# ============================================

# 开发模式：显示详细错误信息（包括环境变量名）
# 生产模式：隐藏敏感信息（默认）
# SCENARIO_VERBOSE_ERRORS=true

# 环境标识
# NODE_ENV=development

# ============================================
# 其他配置（根据项目需要）
# ============================================

# 数据库连接
# DATABASE_URL="postgresql://user:pass@localhost:5432/db"

# 第三方服务
# STRIPE_API_KEY="sk_test_..."
# SENDGRID_API_KEY="SG...."

# ============================================
# 使用示例
# ============================================

# 加载环境变量（Linux/Mac）：
#   export $(cat .env | xargs)
#   node ../../dist/scenario-test-cli.cjs --config scenario.config.js --all

# 加载环境变量（Windows PowerShell）：
#   Get-Content .env | ForEach-Object {
#       $key,$value = $_.Split('=',2)
#       [Environment]::SetEnvironmentVariable($key, $value, 'Process')
#   }
#   node ../../dist/scenario-test-cli.cjs --config scenario.config.js --all

# 一次性使用（Linux/Mac）：
#   SCENARIO_AUTH="Bearer token" node cli.cjs --config config.js

# ============================================
# 安全提醒
# ============================================

# ✅ 务必：
# - 将 .env 添加到 .gitignore
# - 不要提交 .env 到版本控制
# - 定期轮换凭据
# - 不同环境使用不同凭据

# ❌ 不要：
# - 在代码中硬编码凭据
# - 通过命令行参数传递 Token
# - 在日志中记录完整凭据
# - 与他人分享 .env 文件
